# Buildroot 2025.02 defconfig for ESP32-P4 MicroCore.
# Run ../linux/setup-paths.sh first so @ESP32_TINYCORE@ becomes absolute.
# Then:  cp this file to buildroot/.config && make olddefconfig

BR2_riscv=y
BR2_RISCV_32=y
BR2_riscv_custom=y
BR2_RISCV_ISA_CUSTOM_RVM=y
BR2_RISCV_ISA_CUSTOM_RVA=y
BR2_RISCV_ISA_CUSTOM_RVF=y
BR2_RISCV_ISA_CUSTOM_RVC=y
BR2_RISCV_ABI_ILP32F=y
BR2_USE_MMU=n

BR2_TOOLCHAIN_BUILDROOT_UCLIBC=y
BR2_PACKAGE_UCLIBC_BIG_ENDIAN=n

BR2_GLOBAL_PATCH_DIR="@ESP32_TINYCORE@/configs/buildroot/patches/global-patches"

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="v6.18.35"
BR2_LINUX_KERNEL_VERSION="v6.18.35"
BR2_LINUX_KERNEL_PATCH="@ESP32_TINYCORE@/linux/patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="@ESP32_TINYCORE@/linux/kernel.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@ESP32_TINYCORE@/linux/microcore.config"
BR2_LINUX_KERNEL_IMAGE=y
BR2_LINUX_KERNEL_GZIP=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="espressif/esp32p4-microcore"

BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_SQUASHFS=y

# GPIO, Wi-Fi (C6 / ESP-Hosted), SSH
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_CLIENT=y
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y

BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_CPIO_UIMAGE=n

BR2_ROOTFS_OVERLAY="@ESP32_TINYCORE@/rootfs/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="@ESP32_TINYCORE@/image/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="@ESP32_TINYCORE@/image/post-image.sh"
