// SPDX-License-Identifier: GPL-2.0
/*
 * ESP32-P4 MicroCore — HP core RV32IMAFC, PSRAM at 0x48000000,
 * UART0 @ 0x500CA000 (115200 by the linux-loader), SDMMC slot 0.
 *
 * Intended to build against an ESP32-P4 kernel tree that provides
 * the espressif CLIC / UART / GPIO / dw_mmc glue (see linux/README.md).
 */
/dts-v1/;

#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "ESP32-P4 MicroCore";
	compatible = "espressif,esp32p4-microcore", "espressif,esp32p4";

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <16000000>;

		CPU0: cpu@0 {
			device_type = "cpu";
			compatible = "riscv";
			reg = <0>;
			riscv,isa = "rv32imafc";
			mmu-type = "riscv,none";
			status = "okay";

			CPU0_intc: interrupt-controller {
				#interrupt-cells = <1>;
				compatible = "riscv,cpu-intc";
				interrupt-controller;
			};
		};
	};

	memory@48000000 {
		device_type = "memory";
		/* Size patched by linux-loader to the detected PSRAM size. */
		reg = <0x48000000 0x04000000>;
	};

	xtal_clk: xtal-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <40000000>;
		clock-output-names = "xtal";
	};

	aliases {
		serial0 = &uart0;
		mmc0 = &sdmmc;
		gpio0 = &gpio0;
		gpio1 = &gpio1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		linux,initrd-start = <0x11111111>;
		linux,initrd-end = <0x22222222>;
		bootargs = "console=ttyS0,115200n8 earlycon rdinit=/init loglevel=4                                                                ";
	};

	soc: soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;

		clic0: interrupt-controller@20801000 {
			compatible = "espressif,esp32p4-clic";
			reg = <0x20801000 0x3c0>,
			      <0x500d6000 0x200>;
			interrupt-controller;
			#interrupt-cells = <3>;
		};

		systimer: timer@500e2000 {
			compatible = "espressif,esp32p4-systimer";
			reg = <0x500e2000 0x100>;
			interrupts-extended = <&clic0 17 53 IRQ_TYPE_EDGE_RISING>;
			status = "okay";
		};

		uart0: serial@500ca000 {
			compatible = "esp,esp32p4-uart";
			reg = <0x500ca000 0x1000>;
			interrupts-extended = <&clic0 18 31 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&xtal_clk>;
			status = "okay";
		};

		/*
		 * Two banks share MMIO 0x500E0000 (why2025 gpio-esp32p4).
		 * Bank 0: GPIO 0–31. Bank 1: GPIO 32–56.
		 * IRQ is optional; omit until the P4 port maps ETS_GPIO_INTR.
		 */
		gpio0: gpio@500e0000 {
			compatible = "espressif,esp32p4-gpio";
			reg = <0x500e0000 0x1000>;
			gpio-controller;
			#gpio-cells = <2>;
			espressif,bank-id = <0>;
			gpio-line-names =
				"GPIO0", "GPIO1", "GPIO2", "GPIO3",
				"GPIO4", "GPIO5", "GPIO6", "GPIO7",
				"GPIO8", "GPIO9", "GPIO10", "GPIO11",
				"GPIO12", "GPIO13",
				"C6_SDIO_D0", "C6_SDIO_D1",
				"C6_SDIO_D2", "C6_SDIO_D3",
				"C6_SDIO_CLK", "C6_SDIO_CMD",
				"GPIO20", "GPIO21", "GPIO22", "GPIO23",
				"GPIO24", "GPIO25", "GPIO26", "GPIO27",
				"GPIO28", "GPIO29", "GPIO30", "GPIO31";
			status = "okay";
		};

		gpio1: gpio@500e1000 {
			compatible = "espressif,esp32p4-gpio";
			reg = <0x500e0000 0x1000>;
			gpio-controller;
			#gpio-cells = <2>;
			espressif,bank-id = <1>;
			gpio-line-names =
				"GPIO32", "GPIO33", "GPIO34",
				"BOOT_STRAP", "STRAP",
				"UART0_TX", "UART0_RX",
				"SD_D0", "SD_D1", "SD_D2", "SD_D3",
				"SD_CLK", "SD_CMD",
				"GPIO45", "GPIO46", "GPIO47",
				"GPIO48", "GPIO49", "GPIO50", "GPIO51",
				"GPIO52", "GPIO53", "C6_EN",
				"GPIO55", "GPIO56";
			status = "okay";
		};

		sdmmc_biu_clk: sdmmc-biu-clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <40000000>;
			clock-output-names = "sdmmc-biu";
		};

		sdmmc_ciu_clk: sdmmc-ciu-clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <40000000>;
			clock-output-names = "sdmmc-ciu";
		};

		sdmmc_vmmc: regulator-sdmmc-vmmc {
			compatible = "regulator-fixed";
			regulator-name = "sdmmc-vmmc";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			regulator-always-on;
			regulator-boot-on;
		};

		sdmmc: mmc@50083000 {
			compatible = "snps,dw-mshc";
			reg = <0x50083000 0x1000>;
			dma-noncoherent;
			interrupts-extended = <&clic0 22 23 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&sdmmc_biu_clk>, <&sdmmc_ciu_clk>;
			clock-names = "biu", "ciu";
			vmmc-supply = <&sdmmc_vmmc>;
			bus-width = <4>;
			broken-cd;
			disable-wp;
			max-frequency = <25000000>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			/* Slot 0 = onboard microSD (this node). */

			/*
			 * Slot 1 = ESP32-C6 ESP-Hosted (Wi-Fi / BT).
			 * Pins are on the GPIO matrix: CLK=18 CMD=19 D0–D3=14–17.
			 * The linux-loader pulses GPIO 54 (C6 EN) before jump.
			 * Needs an ESP-Hosted / dw_mmc slot-1 binding from the
			 * P4 kernel port (see linux/patches/README.md).
			 */
			c6_sdio: wifi@1 {
				reg = <1>;
				compatible = "espressif,esp-hosted-mcu";
				reset-gpios = <&gpio1 22 GPIO_ACTIVE_HIGH>; /* GPIO 54 */
				status = "okay";
			};
		};
	};
};
