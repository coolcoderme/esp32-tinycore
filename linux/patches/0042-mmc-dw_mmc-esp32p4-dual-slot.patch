From: ESP32-P4 MicroCore <microcore@local>
Date: Sat, 19 Sep 2026 22:00:00 +0000
Subject: [PATCH] mmc: dw_mmc: restore a second slot for ESP32-P4 SDIO

snps,num-slots=<2> creates slot 1 (ESP32-C6 ESP-Hosted) alongside
the microSD on slot 0. The request queue already serializes access.

--- a/drivers/mmc/host/dw_mmc.h	2026-06-09 10:28:53.000000000 +0000
+++ b/drivers/mmc/host/dw_mmc.h	2026-09-19 22:16:06.488262793 +0000
@@ -213,6 +213,8 @@
 	struct clk		*biu_clk;
 	struct clk		*ciu_clk;
 	struct dw_mci_slot	*slot;
+	struct dw_mci_slot	*slots[2];
+	unsigned int		num_slots;
 
 	/* FIFO push and pull */
 	int			fifo_depth;
--- a/drivers/mmc/host/dw_mmc.c	2026-09-19 22:16:55.108432463 +0000
+++ b/drivers/mmc/host/dw_mmc.c	2026-09-19 22:16:18.180301010 +0000
@@ -1416,6 +1416,8 @@
 	struct mmc_request *mrq = slot->mrq;
 	struct mmc_command *cmd;
 
+	/* In-flight slot: IRQ / request_end use host->slot. */
+	host->slot = slot;
 	cmd = mrq->sbc ? mrq->sbc : mrq->cmd;
 	__dw_mci_start_request(host, slot, cmd);
 }
@@ -3038,7 +3040,7 @@
 	return 0;
 }
 
-static int dw_mci_init_slot(struct dw_mci *host)
+static int dw_mci_init_slot(struct dw_mci *host, unsigned int id)
 {
 	struct mmc_host *mmc;
 	struct dw_mci_slot *slot;
@@ -3049,18 +3051,21 @@
 		return -ENOMEM;
 
 	slot = mmc_priv(mmc);
-	slot->id = 0;
+	slot->id = id;
 	/*
-	 * Allow boards that wire their card on a non-zero physical slot
-	 * to opt in via DT (`snps,slot-id`). Default 0 preserves mainline
-	 * behavior — the WHY2025 badge uses slot 0 for its microSD and
-	 * doesn't set this, so it's generic plumbing here, not badge-specific.
-	 */
-	of_property_read_u32(host->dev->of_node, "snps,slot-id", &slot->id);
+	 * Slot 0 can still opt into a non-zero physical slot via
+	 * `snps,slot-id` (single-slot boards). Extra slots created from
+	 * `snps,num-slots` use the loop index as the card_number.
+	 */
+	if (id == 0)
+		of_property_read_u32(host->dev->of_node, "snps,slot-id",
+				     &slot->id);
 	slot->sdio_id = host->sdio_id0 + slot->id;
 	slot->mmc = mmc;
 	slot->host = host;
-	host->slot = slot;
+	host->slots[id] = slot;
+	if (!host->slot)
+		host->slot = slot;
 
 	mmc->ops = &dw_mci_ops;
 
@@ -3072,9 +3077,20 @@
 	if (!mmc->ocr_avail)
 		mmc->ocr_avail = MMC_VDD_32_33 | MMC_VDD_33_34;
 
-	ret = mmc_of_parse(mmc);
-	if (ret)
-		return ret;
+	if (id == 0) {
+		ret = mmc_of_parse(mmc);
+		if (ret)
+			return ret;
+	} else {
+		/*
+		 * Extra slots on ESP32-P4: slot 1 is the Function EV
+		 * ESP32-C6 ESP-Hosted SDIO function. Host-level DT
+		 * describes the microSD (slot 0); do not re-parse it.
+		 */
+		mmc->caps |= MMC_CAP_4_BIT_DATA | MMC_CAP_SDIO_IRQ |
+			     MMC_CAP_NONREMOVABLE;
+		mmc->caps2 |= MMC_CAP2_NO_SD | MMC_CAP2_NO_MMC;
+	}
 
 	ret = dw_mci_init_slot_caps(slot);
 	if (ret)
@@ -3119,9 +3135,14 @@
 
 static void dw_mci_cleanup_slot(struct dw_mci_slot *slot)
 {
+	unsigned int id = slot->id;
+
 	/* Debugfs stuff is cleaned up by mmc core */
 	mmc_remove_host(slot->mmc);
-	slot->host->slot = NULL;
+	if (slot->host->slot == slot)
+		slot->host->slot = NULL;
+	if (id < ARRAY_SIZE(slot->host->slots))
+		slot->host->slots[id] = NULL;
 }
 
 static void dw_mci_init_dma(struct dw_mci *host)
@@ -3618,10 +3639,17 @@
 		 host->irq, width, fifo_size);
 
 	/* We need at least one slot to succeed */
-	ret = dw_mci_init_slot(host);
-	if (ret) {
-		dev_dbg(host->dev, "slot %d init failed\n", i);
-		goto err_dmaunmap;
+	host->num_slots = 1;
+	of_property_read_u32(host->dev->of_node, "snps,num-slots",
+			     &host->num_slots);
+	if (host->num_slots < 1 || host->num_slots > ARRAY_SIZE(host->slots))
+		host->num_slots = 1;
+	for (i = 0; i < host->num_slots; i++) {
+		ret = dw_mci_init_slot(host, i);
+		if (ret) {
+			dev_dbg(host->dev, "slot %d init failed\n", i);
+			goto err_dmaunmap;
+		}
 	}
 
 	/* Now that slots are all setup, we can enable card detect */
@@ -3647,9 +3675,13 @@
 
 void dw_mci_remove(struct dw_mci *host)
 {
+	unsigned int i;
+
 	dev_dbg(host->dev, "remove slot\n");
-	if (host->slot)
-		dw_mci_cleanup_slot(host->slot);
+	for (i = 0; i < host->num_slots; i++) {
+		if (host->slots[i])
+			dw_mci_cleanup_slot(host->slots[i]);
+	}
 
 	mci_writel(host, RINTSTS, 0xFFFFFFFF);
 	mci_writel(host, INTMASK, 0); /* disable all mmc interrupt first */
@@ -3692,6 +3724,7 @@
 int dw_mci_runtime_resume(struct device *dev)
 {
 	int ret = 0;
+	unsigned int i;
 	struct dw_mci *host = dev_get_drvdata(dev);
 
 	if (host->slot &&
@@ -3732,15 +3765,16 @@
 	mci_writel(host, CTRL, SDMMC_CTRL_INT_ENABLE);
 
 
-	if (host->slot && host->slot->mmc->pm_flags & MMC_PM_KEEP_POWER)
-		dw_mci_set_ios(host->slot->mmc, &host->slot->mmc->ios);
-
-	/* Force setup bus to guarantee available clock output */
-	dw_mci_setup_bus(host->slot, true);
-
-	/* Re-enable SDIO interrupts. */
-	if (sdio_irq_claimed(host->slot->mmc))
-		__dw_mci_enable_sdio_irq(host->slot, 1);
+	for (i = 0; i < host->num_slots; i++) {
+		if (!host->slots[i])
+			continue;
+		if (host->slots[i]->mmc->pm_flags & MMC_PM_KEEP_POWER)
+			dw_mci_set_ios(host->slots[i]->mmc,
+				       &host->slots[i]->mmc->ios);
+		dw_mci_setup_bus(host->slots[i], true);
+		if (sdio_irq_claimed(host->slots[i]->mmc))
+			__dw_mci_enable_sdio_irq(host->slots[i], 1);
+	}
 
 	/* Now that slots are all setup, we can enable card detect */
 	dw_mci_enable_cd(host);
