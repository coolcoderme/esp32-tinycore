# Extra kernel options for ESP32-P4 MicroCore.
# Merge these into the P4 NOMMU defconfig (why2025-linux kernel.config
# or equivalent). Do not use this file as a standalone defconfig.

CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_BINFMT_FLAT=y
CONFIG_BINFMT_ELF=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_PRINTK=y
CONFIG_TTY=y
