# Extra kernel options for ESP32-P4 MicroCore.
# Merge these into the P4 NOMMU defconfig (why2025-linux kernel.config
# or equivalent). Do not use this file as a standalone defconfig.

CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_BINFMT_FLAT=y
CONFIG_BINFMT_ELF=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_PRINTK=y
CONFIG_TTY=y

# GPIO (sysfs + /dev/gpiochip; driver is why2025 gpio-esp32p4)
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_CDEV_V1=y
CONFIG_OF_GPIO=y
CONFIG_GPIO_ESP32P4=y

# Networking for Wi-Fi (ESP32-C6 ESP-Hosted) and SSH
CONFIG_NET=y
CONFIG_NET_CORE=y
CONFIG_NETDEVICES=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_PNP=n
CONFIG_NET_NS=n
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_NL80211_TESTMODE=n
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=n

# ESP-Hosted-NG (why2025 in-tree host driver + 0041 SDIO transport)
CONFIG_ESP_HOSTED_NG=y
CONFIG_ESP_HOSTED_NG_SDIO=y

# MMC slot 1 (C6 SDIO) + generic SDIO
CONFIG_MMC_SDHCI=n
CONFIG_MMC_SDIO_UART=n
